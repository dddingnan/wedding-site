# Copy to .env and fill in. Never commit .env.

# Local docker-compose Postgres (default). For Neon, paste its connection string:
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://wedding:wedding@localhost:5432/wedding

# Admin dashboard login
ADMIN_PASSWORD=change-me
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

INVITE_LOOKUP_RATE_LIMIT=10/minute
